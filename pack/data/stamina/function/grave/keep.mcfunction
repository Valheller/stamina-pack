# GENERATED. As the dead player (stamina:grave/make): each slot holding gear keeps it (and it stays out of the
# grave); every other slot is emptied (its item is already in storage stamina:grave new)
execute if items entity @s container.0 *[minecraft:max_damage] run data remove storage stamina:grave new.inv[{Slot:0b}]
execute if items entity @s container.0 #stamina:kept_on_death run data remove storage stamina:grave new.inv[{Slot:0b}]
execute unless items entity @s container.0 *[minecraft:max_damage] unless items entity @s container.0 #stamina:kept_on_death run item replace entity @s container.0 with minecraft:air
